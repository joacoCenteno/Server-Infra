# ==========================================
# CONFIGURACIÓN DEL SERVIDOR FLASK
# ==========================================
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
IP_ADDRESS=ip

# ==========================================
# CONFIGURACIÓN DE POSTGRESQL
# ==========================================
# Cambia 'tu_contraseña' por la contraseña que le asignaste a tu usuario postgres
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_db

# O directamente la URL completa de conexión:
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==========================================
# (OPCIONAL) PROBAR SIN CONFIGURAR POSTGRES
# ==========================================
# Si quieres probar la API inmediatamente en memoria local sin Postgres, pon esto en true:
USE_SQLITE=false
